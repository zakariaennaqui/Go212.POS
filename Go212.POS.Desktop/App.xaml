<Application x:Class="Go212.POS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Go212.POS.Desktop.Converters"
             xmlns:vm="clr-namespace:Go212.POS.Desktop.ViewModels"
             xmlns:vHome="clr-namespace:Go212.POS.Desktop.Views.Home"
             xmlns:vPOS="clr-namespace:Go212.POS.Desktop.Views.POS"
             xmlns:vProducts="clr-namespace:Go212.POS.Desktop.Views.Products"
             xmlns:vStock="clr-namespace:Go212.POS.Desktop.Views.Stock"
             xmlns:vReports="clr-namespace:Go212.POS.Desktop.Views.Reports"
             xmlns:vSettings="clr-namespace:Go212.POS.Desktop.Views.Settings"
             xmlns:vManagement="clr-namespace:Go212.POS.Desktop.Views.Management"
             DispatcherUnhandledException="Application_DispatcherUnhandledException"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/DataGrid.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters (app-wide) -->
            <conv:NullToCollapsedConverter     x:Key="NullToCollapsedConverter"/>
            <conv:BoolToVisibilityConverter    x:Key="BoolToVisibleConverter"/>
            <conv:MadCurrencyConverter         x:Key="MadCurrencyConverter"/>
            <conv:FrenchDateConverter          x:Key="FrenchDateConverter"/>
            <conv:InverseBoolConverter         x:Key="InverseBoolConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibleConverter"/>
            <conv:SaleStatusColorConverter     x:Key="SaleStatusColorConverter"/>

            <!-- MVVM View-ViewModel Mappings -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <vHome:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:POSViewModel}">
                <vPOS:POSView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <vProducts:ProductsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StockViewModel}">
                <vStock:StockView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <vReports:ReportsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <vSettings:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManagementViewModel}">
                <vManagement:ManagementView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
