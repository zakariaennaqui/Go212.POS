<UserControl x:Class="Go212.POS.Desktop.Views.Management.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Gestion &amp; Administration" Style="{StaticResource Heading1}"/>
                <TextBlock Text="Sessions, utilisateurs, clients et depenses de caisse"
                           Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Actualiser"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddExpenseCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                        Visibility="{Binding CanRecordExpense, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="+ Depense"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCurrentSessionCommand}" Style="{StaticResource DangerButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Cloture Caisse (Z)"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab Control -->
        <TabControl Grid.Row="2">

            <!-- 1. Sessions -->
            <TabItem Header="Sessions &amp; Cloture (Rapport Z)">
                <DataGrid Margin="0,12,0,0"
                          ItemsSource="{Binding Sessions}" AutoGenerateColumns="False"
                          IsReadOnly="True" Style="{StaticResource PosDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SESSION #"    Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="STATUT"       Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="OUVERTURE"    Binding="{Binding OpenedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150"/>
                        <DataGridTextColumn Header="CLOTURE"      Binding="{Binding ClosedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150"/>
                        <DataGridTextColumn Header="FOND INITIAL" Binding="{Binding OpeningFloat, StringFormat='{}{0:N2} MAD'}" Width="130"/>
                        <DataGridTextColumn Header="COMPTE"       Binding="{Binding ClosingCounted, StringFormat='{}{0:N2} MAD'}" Width="130"/>
                        <DataGridTemplateColumn Header="ACTIONS"  Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Rapport Z"
                                            Command="{Binding DataContext.ShowZReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ActionButton}"
                                            Padding="8,4" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 2. Users -->
            <TabItem Header="Utilisateurs">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Create user form (Admin only) -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardPanel}"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisibleConverter}}">
                        <StackPanel>
                            <TextBlock Text="Creer un Utilisateur" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

                            <Label Content="NOM COMPLET" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                            <Label Content="IDENTIFIANT (LOGIN)" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewUserUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                            <Label Content="PIN (4+ CHIFFRES)" Style="{StaticResource FormLabel}"/>
                            <PasswordBox x:Name="PinBox"
                                         Style="{StaticResource PinInput}"
                                         PasswordChanged="PinBox_PasswordChanged"
                                         Margin="0,2,0,10"/>

                            <Label Content="ROLE" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableRoles}"
                                      SelectedItem="{Binding NewUserRole}"
                                      Margin="0,2,0,16"/>

                            <Button Command="{Binding CreateUserCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Creer l'utilisateur"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT: User list -->
                    <DataGrid Grid.Column="2"
                              ItemsSource="{Binding Users}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource PosDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOM"              Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="IDENTIFIANT"      Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="ROLE"             Binding="{Binding Role}" Width="90"/>
                            <DataGridTextColumn Header="ACTIF"            Binding="{Binding IsActive}" Width="60"/>
                            <DataGridTextColumn Header="TENTATIVES"       Binding="{Binding FailedPinAttempts}" Width="90"/>
                            <DataGridTextColumn Header="DERNIERE CONNEXION" Binding="{Binding LastLoginAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="140"/>
                            <DataGridTemplateColumn Header="ACTIONS" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <Button Content="Debloquer"
                                                    Command="{Binding DataContext.UnlockUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ActionButton}"
                                                    Margin="0,0,4,0"
                                                    Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVisibleConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Button Content="Reset PIN"
                                                    Command="{Binding DataContext.ResetUserPinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ActionButton}"
                                                    Margin="0,0,4,0"
                                                    Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVisibleConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            <Button Content="Desactiver"
                                                    Command="{Binding DataContext.DeactivateUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Visibility="{Binding DataContext.CanManageUsers, Converter={StaticResource BoolToVisibleConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 3. Clients -->
            <TabItem Header="Clients">
                <DataGrid Margin="0,12,0,0"
                          ItemsSource="{Binding Customers}" AutoGenerateColumns="False"
                          IsReadOnly="True" Style="{StaticResource PosDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOM COMPLET"    Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="TELEPHONE"      Binding="{Binding Phone}" Width="150"/>
                        <DataGridTextColumn Header="EMAIL"          Binding="{Binding Email}" Width="200"/>
                        <DataGridTextColumn Header="CREDIT COURANT" Binding="{Binding CurrentCredit, StringFormat='{}{0:N2} MAD'}" Width="140"/>
                        <DataGridTextColumn Header="PLAFOND"        Binding="{Binding CreditLimit, StringFormat='{}{0:N2} MAD'}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 4. Depenses -->
            <TabItem Header="Depenses de Caisse">
                <DataGrid Margin="0,12,0,0"
                          ItemsSource="{Binding Expenses}" AutoGenerateColumns="False"
                          IsReadOnly="True" Style="{StaticResource PosDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE"        Binding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="150"/>
                        <DataGridTextColumn Header="MONTANT"     Binding="{Binding Amount, StringFormat='{}{0:N2} MAD'}" Width="130"/>
                        <DataGridTextColumn Header="CATEGORIE"   Binding="{Binding Category}" Width="150"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
