<UserControl x:Class="Go212.POS.Desktop.Views.Stock.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Low Stock List + History -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Produits en Alerte de Stock" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}" SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource PosDataGrid}" Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUIT" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="STOCK ACTUEL" Binding="{Binding StockQuantity}" Width="110"/>
                    <DataGridTextColumn Header="SEUIL ALERTE" Binding="{Binding StockAlertThreshold}" Width="110"/>
                    <DataGridTemplateColumn Header="HISTORIQUE" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Voir Mouvements" Style="{StaticResource BtnSecondary}" Padding="6,3" FontSize="11"
                                        Command="{Binding DataContext.LoadMovementsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="Historique des Mouvements" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
            <DataGrid Grid.Row="3" ItemsSource="{Binding RecentMovements}"
                      AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource PosDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding CreatedAt, Converter={StaticResource FrenchDateConverter}}" Width="140"/>
                    <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="VARIATION" Binding="{Binding QuantityChange, StringFormat='{}{0:+0;-0;0}'}" Width="90"/>
                    <DataGridTextColumn Header="STOCK APRÈS" Binding="{Binding QuantityAfter}" Width="100"/>
                    <DataGridTextColumn Header="MOTIF" Binding="{Binding Reason}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Right: Stock Adjustment Panel -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="20,0,0,0" Padding="20">
            <StackPanel>
                <TextBlock Text="Ajustement de Stock" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

                <Border Background="#FFDCFCE7" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12"/>
                </Border>

                <Label Content="PRODUIT SÉLECTIONNÉ" Style="{StaticResource FormLabel}"/>
                <TextBlock Text="{Binding SelectedProduct.Name, FallbackValue='(Cliquez sur un produit dans la liste)'}"
                           FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>

                <Label Content="QUANTITÉ D'AJUSTEMENT (+ entrée / - sortie) *" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <Label Content="MOTIF DE L'AJUSTEMENT *" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Ex: Réception fournisseur, Perte, Casse..." Height="60" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <Button Content="Valider l'Ajustement" Style="{StaticResource BtnPrimary}" Command="{Binding AdjustStockCommand}" Height="48"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
