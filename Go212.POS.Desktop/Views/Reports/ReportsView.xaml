<UserControl x:Class="Go212.POS.Desktop.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer Padding="20">
        <StackPanel>
            <!-- Header + Date Picker -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Rapports &amp; Statistiques" Style="{StaticResource Heading1}"/>
                    <TextBlock Text="Rapport journalier (Z-Report) et recapitulatif des encaissements"
                               Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding SelectedDate}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding LoadDailyReportCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock Text="Generer Rapport"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSecondary}" Command="{Binding ExportPdfCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE3;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock Text="Exporter PDF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- KPI Cards -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL TTC" Style="{StaticResource FormLabelText}"/>
                        <TextBlock Text="{Binding DailyReport.TotalTTC, StringFormat='{}{0:N2} MAD'}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Go212GreenBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="SOUS-TOTAL HT" Style="{StaticResource FormLabelText}"/>
                        <TextBlock Text="{Binding DailyReport.TotalHT, StringFormat='{}{0:N2} MAD'}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL TVA COLLECTEE" Style="{StaticResource FormLabelText}"/>
                        <TextBlock Text="{Binding DailyReport.TotalTax, StringFormat='{}{0:N2} MAD'}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sales by payment method -->
            <TextBlock Text="Encaissements par Mode de Paiement"
                       Style="{StaticResource Heading2}" Margin="0,0,0,10"/>
            <DataGrid ItemsSource="{Binding DailyReport.PaymentBreakdown}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource PosDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MODE DE PAIEMENT"  Binding="{Binding Method}" Width="*"/>
                    <DataGridTextColumn Header="MONTANT ENCAISSE"  Binding="{Binding TotalAmount, StringFormat='{}{0:N2} MAD'}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
