<Window x:Class="Go212.POS.Desktop.Views.Home.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GO212 POS"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>   <!-- Sidebar -->
            <ColumnDefinition Width="*"/>     <!-- Content -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════
             SIDEBAR — Light, sharp, left border
             ═══════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Logo -->
                    <RowDefinition Height="Auto"/>   <!-- User info -->
                    <RowDefinition Height="*"/>      <!-- Nav links -->
                    <RowDefinition Height="Auto"/>   <!-- Bottom -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0"
                        Background="{StaticResource Go212GreenBrush}"
                        Padding="16,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="G" FontSize="18" FontWeight="Black"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="GO212 POS" FontSize="13" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="v1.0" FontSize="10"
                                       Foreground="#CCffffff"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Logged-in user -->
                <Border Grid.Row="1"
                        Background="{StaticResource SidebarActiveBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentSession.Username}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentSession.Role}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Navigation — Segoe MDL2 Assets icons -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">

                    <Button x:Name="BtnHome"
                            Style="{StaticResource BtnNavItem}"
                            Command="{Binding NavigateCommand}" CommandParameter="Home"
                            Tag="Home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Accueil" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPOS"
                            Style="{StaticResource BtnNavItem}"
                            Command="{Binding NavigateCommand}" CommandParameter="POS"
                            Tag="POS">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Caisse" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnProducts"
                            Style="{StaticResource BtnNavItem}"
                            Command="{Binding NavigateCommand}" CommandParameter="Products"
                            Tag="Products">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Catalogue" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStock"
                            Style="{StaticResource BtnNavItem}"
                            Command="{Binding NavigateCommand}" CommandParameter="Stock"
                            Tag="Stock">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Stock" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnManagement"
                            Style="{StaticResource BtnNavItem}"
                            Command="{Binding NavigateCommand}" CommandParameter="Management"
                            Tag="Management"
                            Visibility="{Binding CanAccessManagement, Converter={StaticResource BoolToVisibleConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Gestion" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnReports"
                            Style="{StaticResource BtnNavItem}"
                            Command="{Binding NavigateCommand}" CommandParameter="Reports"
                            Tag="Reports">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Rapports" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSettings"
                            Style="{StaticResource BtnNavItem}"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"
                            Tag="Settings"
                            Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVisibleConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Parametres" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Bottom: alerts + logout -->
                <StackPanel Grid.Row="3" Margin="0,0,0,0">
                    <Separator/>
                    <!-- Stock alert -->
                    <Border Background="#FFFEF3C7"
                            BorderBrush="#FFF59E0B"
                            BorderThickness="0,0,0,0"
                            Padding="16,8"
                            Visibility="{Binding HasLowStockAlerts, Converter={StaticResource BoolToVisibleConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} alertes stock'}"
                                       Foreground="{StaticResource WarningBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource BtnNavItem}"
                            Command="{Binding LogoutCommand}"
                            Foreground="{StaticResource DangerBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Width="22" VerticalAlignment="Center"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="Deconnexion" Margin="8,0,0,0"
                                       Foreground="{StaticResource DangerBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             CONTENT AREA
             ═══════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <!-- Top bar -->
            <Border VerticalAlignment="Top" Height="48"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <TextBlock Text="{Binding CurrentPageTitle}"
                               Style="{StaticResource Heading3}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentDateTime}"
                               Style="{StaticResource TextSecondary}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Page content -->
            <ContentControl Content="{Binding CurrentPage}"
                            Margin="0,48,0,0"/>
        </Grid>
    </Grid>
</Window>
