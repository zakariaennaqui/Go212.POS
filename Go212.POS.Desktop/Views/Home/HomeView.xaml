<UserControl x:Class="Go212.POS.Desktop.Views.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer Padding="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Tableau de Bord" Style="{StaticResource Heading1}" Margin="0,0,0,2"/>
            <TextBlock Text="Apercu des performances et alertes du jour"
                       Style="{StaticResource TextSecondary}" Margin="0,0,0,20"/>

            <!-- Metric Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Revenue Today -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20" Foreground="{StaticResource Go212GreenBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="CHIFFRE D'AFFAIRES (JOUR)" Style="{StaticResource FormLabelText}"/>
                        <TextBlock Text="{Binding TodayRevenue, StringFormat='{}{0:N2} MAD'}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Go212GreenBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Transactions Today -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="VENTES REALISEES" Style="{StaticResource FormLabelText}"/>
                        <TextBlock Text="{Binding TodaySaleCount, StringFormat='{}{0} tickets'}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Low Stock Alerts -->
                <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="ALERTES STOCK" Style="{StaticResource FormLabelText}"/>
                        <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} articles'}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Session Status -->
                <Border Grid.Column="3" Style="{StaticResource CardPanel}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="STATUT DE CAISSE" Style="{StaticResource FormLabelText}"/>
                        <TextBlock Text="Caisse Ouverte" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibleConverter}}"/>
                        <TextBlock Text="Caisse Fermee" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding HasOpenSession, Converter={StaticResource InverseBoolToVisibleConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <TextBlock Text="Actions Rapides" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,24">
                <Button Style="{StaticResource BtnPrimary}" Padding="18,12" FontSize="14" Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="POS">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Ouvrir la Caisse"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnSecondary}" Padding="18,12" FontSize="14" Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Products">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Ajouter un Produit"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnSecondary}" Padding="18,12" FontSize="14" Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Stock">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Ajuster le Stock"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnSecondary}" Padding="18,12" FontSize="14" Margin="0,0,12,12"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Reports">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Voir les Rapports"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
