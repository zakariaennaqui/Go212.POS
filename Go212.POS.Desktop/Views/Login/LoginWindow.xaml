<Window x:Class="Go212.POS.Desktop.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GO212 POS — Connexion"
        Height="540" Width="860"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT — Branding panel (GO212 green) -->
        <Border x:Name="BrandPanel" Grid.Column="0" Background="{StaticResource Go212GreenBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Brand -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="40,0">
                    <!-- GO212 Logo block -->
                    <Border Width="72" Height="72"
                            Background="White"
                            HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="G" FontSize="40" FontWeight="Black"
                                   Foreground="{StaticResource Go212GreenBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="GO212 POS" FontSize="26" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Systeme de Caisse"
                               Foreground="#CCffffff"
                               FontSize="13"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <!-- Feature list -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6" Background="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Vente rapide avec scan code-barres"
                                       Foreground="#CCffffff" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6" Background="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Impression thermique ESC/POS"
                                       Foreground="#CCffffff" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6" Background="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Rapports et statistiques en temps reel"
                                       Foreground="#CCffffff" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" Background="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Fonctionne 100% hors-ligne"
                                       Foreground="#CCffffff" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Version footer -->
                <TextBlock Grid.Row="3"
                           Text="Version 1.0 — Aout 2026"
                           Foreground="#99ffffff"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
            </Grid>
        </Border>

        <!-- RIGHT — Login form (white) -->
        <Border Grid.Column="1" Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <!-- Close button -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,12,0" Width="30" Height="30"
                        Style="{StaticResource BtnSecondary}" FontSize="13"
                        Command="{Binding CloseCommand}"
                        Padding="0" BorderThickness="1" Content="&#x2715;"/>

                <StackPanel VerticalAlignment="Center" Margin="50,0">

                    <TextBlock Text="Connexion" Style="{StaticResource Heading1}" Margin="0,0,0,6"/>
                    <TextBlock Text="Selectionnez votre compte et saisissez votre PIN"
                               Style="{StaticResource TextSecondary}" Margin="0,0,0,32"/>

                    <!-- User selector -->
                    <Label Content="UTILISATEUR" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              DisplayMemberPath="Name"
                              Margin="0,2,0,16"/>

                    <!-- PIN field -->
                    <Label Content="CODE PIN" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="PinBox"
                                 Style="{StaticResource PinInput}"
                                 PasswordChanged="PinBox_PasswordChanged"
                                 KeyDown="PinBox_KeyDown"
                                 Margin="0,2,0,12"/>

                    <!-- Error message -->
                    <Border Background="#FFFEE2E2" Padding="12,8"
                            Margin="0,0,0,16"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Login button -->
                    <Button Content="SE CONNECTER" Style="{StaticResource BtnPrimary}"
                            Command="{Binding LoginCommand}"
                            HorizontalAlignment="Stretch"
                            Height="48" FontSize="15"/>

                    <!-- Lock warning -->
                    <TextBlock Margin="0,14,0,0"
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"
                               HorizontalAlignment="Center"
                               Text="{Binding LockMessage}"
                               Visibility="{Binding LockMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
