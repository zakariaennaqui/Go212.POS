<UserControl x:Class="Go212.POS.Desktop.Views.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl>

            <!-- TAB 1: Produits -->
            <TabItem Header="Produits">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search + New -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBox Width="320" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ActionButton}" Command="{Binding SearchCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                                    <TextBlock Text="Rechercher"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}"
                                Command="{Binding NewProductCommand}"
                                Visibility="{Binding CanEditProducts, Converter={StaticResource BoolToVisibleConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Nouveau Produit"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Products list + edit panel -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid -->
                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource PosDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="IMAGE" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding ImagePath}"
                                                   Width="40" Height="40"
                                                   Stretch="UniformToFill"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="NOM DU PRODUIT" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="CATEGORIE"      Binding="{Binding CategoryName}" Width="120"/>
                                <DataGridTextColumn Header="CODE-BARRES"    Binding="{Binding Barcode}" Width="140"/>
                                <DataGridTextColumn Header="PRIX HT"        Binding="{Binding PriceHT, StringFormat='{}{0:N2} MAD'}" Width="100"/>
                                <DataGridTextColumn Header="TVA (%)"        Binding="{Binding TaxRate, StringFormat='{}{0:N0}%'}" Width="75"/>
                                <DataGridTextColumn Header="PRIX TTC"       Binding="{Binding PriceTTC, StringFormat='{}{0:N2} MAD'}" Width="105"/>
                                <DataGridTextColumn Header="STOCK"          Binding="{Binding StockQuantity}" Width="70"/>
                                <DataGridTemplateColumn Header="ACTIONS"    Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <Button Content="Modifier" Style="{StaticResource ActionButton}" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.CanEditProducts, Converter={StaticResource BoolToVisibleConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Button Content="Desactiver" Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.CanEditProducts, Converter={StaticResource BoolToVisibleConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Edit/Create Drawer -->
                        <Border Grid.Column="1" Width="380"
                                Style="{StaticResource CardPanel}"
                                Margin="16,0,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibleConverter}}">
                            <ScrollViewer>
                                <StackPanel>
                                    <TextBlock Text="Fiche Produit" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

                                    <!-- Error -->
                                    <Border Background="#FFFEE2E2" Padding="12,8" Margin="0,0,0,10"
                                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12"/>
                                    </Border>

                                    <!-- Product image -->
                                    <Label Content="IMAGE DU PRODUIT" Style="{StaticResource FormLabel}"/>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Width="180" Height="130" HorizontalAlignment="Left" Margin="0,4,0,8">
                                        <Grid>
                                            <Image Source="{Binding EditImagePath}" Stretch="UniformToFill"/>
                                            <TextBlock Text="Aucune image"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding EditImagePath, Converter={StaticResource NullToCollapsedConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <Button Command="{Binding PickImageCommand}"
                                            Style="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0"/>
                                            <TextBlock Text="Choisir une image..."/>
                                        </StackPanel>
                                    </Button>

                                    <Label Content="NOM DU PRODUIT *" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                                    <Label Content="CATEGORIE *" Style="{StaticResource FormLabel}"/>
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              SelectedValue="{Binding EditCategoryId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Margin="0,2,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="PRIX HT (MAD) *" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding EditPriceHT, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <Label Content="TAUX TVA (%)" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding EditTaxRate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Label Content="CODE-BARRES (EAN13)" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <Label Content="UNITE" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding EditUnit, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <Label Content="SEUIL ALERTE" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding EditAlertThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Save / Cancel -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Annuler"
                                                Style="{StaticResource BtnSecondary}"
                                                Command="{Binding CancelEditCommand}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="1" Content="Enregistrer"
                                                Style="{StaticResource BtnPrimary}"
                                                Command="{Binding SaveCommand}" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Categories CRUD -->
            <TabItem Header="Categories"
                     Visibility="{Binding CanEditProducts, Converter={StaticResource BoolToVisibleConverter}}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category form -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Nouvelle Categorie" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

                            <Label Content="NOM DE LA CATEGORIE *" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                            <Label Content="COULEUR (code hex)" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding NewCategoryColor, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,2,0,16"/>

                            <Button Command="{Binding CreateCategoryCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Creer la categorie"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding CategoryStatusMessage}"
                                       Style="{StaticResource TextSecondary}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Category list -->
                    <DataGrid Grid.Column="2"
                              ItemsSource="{Binding Categories}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource PosDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"   Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="NOM"  Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="COULEUR" Binding="{Binding Color}" Width="120"/>
                            <DataGridTextColumn Header="PRODUITS" Binding="{Binding ProductCount}" Width="90"/>
                            <DataGridTemplateColumn Header="ACTIONS" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Supprimer"
                                                Style="{StaticResource DangerButton}"
                                                Padding="6,3" FontSize="11"
                                                Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
