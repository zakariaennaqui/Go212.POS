<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         GO212 POS — Design System Colors
         Brand: #00BF63 (GO212 Green) | Light professional theme
         ═══════════════════════════════════════════════════════ -->

    <!-- Brand -->
    <Color x:Key="Go212GreenColor">#FF00BF63</Color>
    <Color x:Key="Go212GreenDarkColor">#FF009E52</Color>
    <Color x:Key="Go212GreenLightColor">#FFE6FFF3</Color>

    <!-- Surfaces — LIGHT theme -->
    <Color x:Key="BackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceElevated1Color">#FFEEEEEE</Color>
    <Color x:Key="SurfaceElevated2Color">#FFE0E0E0</Color>
    <Color x:Key="SidebarColor">#FFFFFFFF</Color>
    <Color x:Key="SidebarActiveColor">#FFF4F4F4</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FF1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#FF5A5A5A</Color>
    <Color x:Key="TextMutedColor">#FF9E9E9E</Color>
    <Color x:Key="TextOnDarkColor">#FFFFFFFF</Color>
    <Color x:Key="TextOnGreenColor">#FFFFFFFF</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#FFD8D8D8</Color>
    <Color x:Key="BorderFocusColor">#FF00BF63</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#FF10B981</Color>
    <Color x:Key="WarningColor">#FFF59E0B</Color>
    <Color x:Key="DangerColor">#FFEF4444</Color>
    <Color x:Key="InfoColor">#FF3B82F6</Color>

    <!-- POS specific -->
    <Color x:Key="CartBackgroundColor">#FFF8F8F8</Color>
    <Color x:Key="CartTextColor">#FF1A1A1A</Color>
    <Color x:Key="ProductCardColor">#FFFFFFFF</Color>
    <Color x:Key="ProductCardHoverColor">#FFF0FFF7</Color>
    <Color x:Key="TotalBarColor">#FF00BF63</Color>

    <!-- ── SolidColorBrushes ─────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryBrush"           Color="#FF00BF63"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"       Color="#FF009E52"/>
    <SolidColorBrush x:Key="Go212GreenBrush"        Color="{StaticResource Go212GreenColor}"/>
    <SolidColorBrush x:Key="Go212GreenDarkBrush"    Color="{StaticResource Go212GreenDarkColor}"/>
    <SolidColorBrush x:Key="Go212GreenLightBrush"   Color="{StaticResource Go212GreenLightColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush"        Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"           Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevated1Brush"  Color="{StaticResource SurfaceElevated1Color}"/>
    <SolidColorBrush x:Key="SurfaceElevated2Brush"  Color="{StaticResource SurfaceElevated2Color}"/>
    <SolidColorBrush x:Key="SidebarBrush"           Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"     Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"         Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"        Color="{StaticResource TextOnDarkColor}"/>
    <SolidColorBrush x:Key="BorderBrush"            Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush"       Color="{StaticResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"           Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush"            Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush"              Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="CartBackgroundBrush"    Color="{StaticResource CartBackgroundColor}"/>
    <SolidColorBrush x:Key="CartTextBrush"          Color="{StaticResource CartTextColor}"/>
    <SolidColorBrush x:Key="ProductCardBrush"       Color="{StaticResource ProductCardColor}"/>
    <SolidColorBrush x:Key="TotalBarBrush"          Color="{StaticResource TotalBarColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"     Color="#FFE0E0E0"/>

</ResourceDictionary>
